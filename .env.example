# Copy this file to .env or export these variables in your shell.
#
# If OPENAI_API_KEY is present and the providers below are set to openai,
# the app uses OpenAI-compatible embedding and chat APIs.
# Without a key, the app falls back to deterministic local providers so the
# pipeline can still be tested during development.

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Leave providers unset to auto-select:
# - OPENAI_API_KEY present: openai
# - OPENAI_API_KEY absent: local
#
# You can also force one mode:
# EMBEDDING_PROVIDER=openai
# LLM_PROVIDER=openai
# EMBEDDING_PROVIDER=local
# LLM_PROVIDER=local

EMBEDDING_MODEL=text-embedding-3-small

LLM_MODEL=gpt-4o-mini

CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=4
MAX_UPLOAD_MB=20
UPLOAD_DIR=data/uploads
